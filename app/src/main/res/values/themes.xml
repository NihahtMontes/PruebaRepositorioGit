<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- La interfaz es Compose; el tema de ventana solo define el fondo inicial. -->
    <style name="Theme.LockApp" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_light</item>
    </style>

    <!-- Fondo opaco y sin animación para que no se vea la app bloqueada debajo. -->
    <style name="Theme.LockApp.Lock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/lock_window</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>
</resources>
